# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origem do frontend (Angular). Usada no CORS e no redirect pós-login Google.
FRONTEND_URL=http://localhost:4200

# ─── Banco de dados (PostgreSQL / Neon) ───────────────────────────────────────
# Neon: copie a "connection string" do painel (já vem com ?sslmode=require).
# Local (compose.yaml): postgresql://dutrail:dutrail@localhost:5433/dutrail
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dutrail?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere segredos fortes e DIFERENTES entre si (>= 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-com-pelo-menos-32-chars
# Formato aceito pelo jsonwebtoken: 15m, 1h, 7d...
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Deve ser IDÊNTICA à "Authorized redirect URI" cadastrada no console.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Object storage dos arquivos .fit (S3-compatível / Oracle Cloud) ─────────
# Endpoint S3-compatível do Object Storage da Oracle:
#   https://<namespace>.compat.objectstorage.<região>.oraclecloud.com
# Credenciais: "Customer Secret Key" do usuário (Perfil → Customer secret keys).
# Nunca commite os valores reais.
OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<regiao>.oraclecloud.com
OCI_S3_REGION=sa-saopaulo-1
OCI_S3_BUCKET=dutrail-fit-files
OCI_S3_ACCESS_KEY=troque-pela-access-key
OCI_S3_SECRET_KEY=troque-pela-secret-key

# ─── Rate limiting (global) ───────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
