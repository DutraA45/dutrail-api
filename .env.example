# ─── Aplicação ────────────────────────────────────────────────────────────────
# Obrigatório, sem default: development | test | production. Em production o
# boot recusa credenciais com cara de placeholder (os valores deste arquivo).
NODE_ENV=development
PORT=3000
# Origem do frontend (Angular). Usada no CORS e no redirect pós-login Google.
FRONTEND_URL=http://localhost:4200
# Flag Secure do cookie do refresh token (padrão true; false é recusado em
# production). Chrome e Firefox aceitam cookie Secure em http://localhost;
# Safari não: nesse caso defina COOKIE_SECURE=false no seu .env local.
COOKIE_SECURE=true
# Log estruturado de eventos de segurança (login, refresh, 429...; ver
# "Logs de segurança" no README). Padrão true; desligue só em testes.
SECURITY_LOG_ENABLED=true

# ─── Banco de dados (PostgreSQL / Neon) ───────────────────────────────────────
# Neon: copie a "connection string" do painel (já vem com ?sslmode=require).
# Local (compose.yaml): postgresql://dutrail:dutrail@localhost:5433/dutrail
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dutrail?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere segredos fortes e DIFERENTES entre si (>= 32 chars; em production
# >= 43 chars e sem trechos como "troque"/"secret" — estes daqui são recusados):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-com-pelo-menos-32-chars
# Inteiro positivo + unidade s, m, h ou d (15m, 1h, 7d). Número sem unidade é
# recusado (o jsonwebtoken o leria como milissegundos). Tetos: access <= 1h,
# refresh <= 30d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Claim `iss` dos tokens (opcional, padrão dutrail-api). Trocar o valor
# invalida todos os tokens já emitidos.
# JWT_ISSUER=dutrail-api

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Deve ser IDÊNTICA à "Authorized redirect URI" cadastrada no console.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Object storage dos arquivos .fit (S3-compatível / Oracle Cloud) ─────────
# Endpoint S3-compatível do Object Storage da Oracle:
#   https://<namespace>.compat.objectstorage.<região>.oraclecloud.com
# Credenciais: "Customer Secret Key" do usuário (Perfil → Customer secret keys).
# Nunca commite os valores reais.
OCI_S3_ENDPOINT=https://seu-namespace.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
OCI_S3_REGION=sa-saopaulo-1
OCI_S3_BUCKET=dutrail-fit-files
OCI_S3_ACCESS_KEY=troque-pela-access-key
OCI_S3_SECRET_KEY=troque-pela-secret-key

# ─── Rate limiting (global) ───────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
