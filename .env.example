# ─── Aplicação ────────────────────────────────────────────────────────────────
# Obrigatório, sem default: development | test | production. Em production o
# boot recusa credenciais com cara de placeholder (os valores deste arquivo).
NODE_ENV=development
PORT=3000
# Interface em que a API escuta (só IP). Padrão 127.0.0.1: só conexões locais.
# No dev, para testar o app mobile pela rede local, use HOST=0.0.0.0.
HOST=127.0.0.1
# Origem do frontend (Angular). Usada só no redirect pós-login Google; o CORS é
# o CORS_ORIGINS abaixo.
FRONTEND_URL=http://localhost:4200
# Origens liberadas no CORS (com credentials), separadas por vírgula, no formato
# exato do header Origin: http(s)://host[:porta], sem barra final. "*" é
# recusado. Vazio = sem CORS cross-origin, quando frontend e API estão na mesma
# origem. No dev, a origem do `ng serve`:
CORS_ORIGINS=http://localhost:4200
# Flag Secure do cookie do refresh token (padrão true; false é recusado em
# production). Chrome e Firefox aceitam cookie Secure em http://localhost;
# Safari não: nesse caso defina COOKIE_SECURE=false no seu .env local.
COOKIE_SECURE=true
# Log estruturado de eventos de segurança (login, refresh, 429...). Padrão
# true; desligue só em testes.
SECURITY_LOG_ENABLED=true
# Checagem de senha vazada no cadastro (Have I Been Pwned, por k-anonymity:
# só 5 caracteres do SHA-1 da senha saem do servidor). Padrão true; exige
# HTTPS de saída para api.pwnedpasswords.com. Se a API não responder no prazo
# (padrão 2000 ms, de 100 a 10000), o cadastro segue e sai um warn no log.
BREACHED_PASSWORD_CHECK=true
# BREACHED_PASSWORD_TIMEOUT_MS=2000
# Jobs agendados, como a limpeza diária de tokens expirados (padrão true).
# Com mais de uma instância da API, cada uma executa o job (os DELETEs são
# idempotentes).
SCHEDULER_ENABLED=true

# ─── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# Local (compose.yaml): postgresql://dutrail:dutrail@localhost:5433/dutrail
DATABASE_URL=postgresql://user:troque-a-senha@localhost:5432/dutrail

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere segredos fortes e DIFERENTES entre si (>= 32 chars; em production
# >= 43 chars e sem trechos como "troque"/"secret" — estes daqui são recusados):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-troque-troque-troque-troque-troque
JWT_REFRESH_SECRET=troque-outro-troque-outro-troque-outro
# Inteiro positivo + unidade s, m, h ou d (15m, 1h, 7d). Número sem unidade é
# recusado (o jsonwebtoken o leria como milissegundos). Tetos: access <= 1h,
# refresh <= 30d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Janela de tolerância do refresh token, em segundos (padrão 30, máximo 60,
# 0 desativa). Dentro dela, um refresh token recém-rotacionado pode ser
# reapresentado UMA vez (resposta perdida, duas abas) e recebe um par novo na
# mesma sessão, em vez de contar como reuso.
REFRESH_GRACE_SECONDS=30
# Claim `iss` dos tokens (opcional, padrão dutrail-api). Trocar o valor
# invalida todos os tokens já emitidos.
# JWT_ISSUER=dutrail-api

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Deve ser IDÊNTICA à "Authorized redirect URI" cadastrada no console. O
# caminho é sempre /api/auth/google/callback (em produção, https://HOST/api/...).
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── Object storage dos arquivos .fit (S3-compatível) ────────────────────────
# Object storage S3-compatível: endpoint, região, bucket e chave de acesso do
# provedor. Nunca commite os valores reais.
OCI_S3_ENDPOINT=https://s3.example.com
OCI_S3_REGION=region
OCI_S3_BUCKET=my-bucket
OCI_S3_ACCESS_KEY=troque-pela-access-key
OCI_S3_SECRET_KEY=troque-pela-secret-key

# ─── Rate limiting e proxy ────────────────────────────────────────────────────
# Limite global por IP (as rotas de autenticação têm limites próprios).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Limite de falhas de login por conta (por email, exista ou não a conta):
# passando de LOGIN_MAX_FAILURES (1 a 100, padrão 5) dentro de
# LOGIN_FAILURE_WINDOW_MINUTES (1 a 60, padrão 15), o login daquele email
# responde 429, mesmo com a senha certa, até a janela acabar.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
# `trust proxy` do Express: de quem aceitar o X-Forwarded-For para definir o IP
# do cliente (rate limit e log de segurança). DESLIGADO (vazio) enquanto não
# houver proxy na frente da API. Aceita: número de saltos (1 a 10; ex.: 1 para
# um proxy reverso na mesma máquina), ou lista de IPs/CIDRs e dos nomes
# loopback, linklocal, uniquelocal. "true" e "*" são recusados. Confirme a
# topologia antes de definir.
TRUST_PROXY=
