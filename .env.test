# Usado apenas pelos testes e2e (npm run test:e2e). Não contém segredos reais.
# Aponta para o Postgres local do compose.yaml. As tabelas são LIMPAS a cada
# teste — nunca aponte para um banco com dados que importam.
# Obrigatório (development | test | production).
NODE_ENV=test
PORT=0
FRONTEND_URL=http://localhost:4200
# Chrome e Firefox aceitam cookie Secure em http://localhost; Safari não, e o
# cookie jar do supertest também não o reenvia em http:// — por isso false.
COOKIE_SECURE=false
# Silencia o log de segurança na saída dos testes. Os testes do próprio log
# (test/security-log.e2e-spec.ts) sobem a app com true e capturam as linhas.
SECURITY_LOG_ENABLED=false
DATABASE_URL=postgresql://dutrail:dutrail@localhost:5433/dutrail_test
JWT_SECRET=test-access-secret-000000000000000000000000000000
JWT_REFRESH_SECRET=test-refresh-secret-00000000000000000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Storage: os e2e substituem o cliente S3 por um fake em memória
# (test/fakes/fake-activity-file-storage.ts). Os valores só passam na validação.
OCI_S3_ENDPOINT=http://localhost:9000
OCI_S3_REGION=test-region
OCI_S3_BUCKET=dutrail-fit-files-test
OCI_S3_ACCESS_KEY=test-access-key
OCI_S3_SECRET_KEY=test-secret-key
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
